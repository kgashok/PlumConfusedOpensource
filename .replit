
entrypoint = "server.js"
modules = ["nodejs-22", "postgresql-16"]
hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "node server.js"]
deploymentTarget = "cloudrun"

[languages.elm]
pattern = "**/*.elm"
[languages.elm.languageServer]
start = ["elm-language-server"]

# Compile Elm before starting server
[commands]
compile = "sh build.sh"

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
runButton = "Run"
author = "agent"
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run"

[[workflows.workflow]]
name = "Run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh build.sh && node server.js"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
